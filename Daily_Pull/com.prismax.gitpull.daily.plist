<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.prismax.gitpull.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>__DAILY_PULL_DIR__/prismax-daily-pull</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__DAILY_PULL_DIR__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__DAILY_PULL_DIR__/log/daily_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__DAILY_PULL_DIR__/log/daily_stderr.log</string>
</dict>
</plist>
